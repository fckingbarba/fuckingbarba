{
  "ci": {
    "collect": {
      "startServerCommand": "node ferramentas/servidor-aquecido.mjs",
      "startServerReadyPattern": "servidor aquecido",
      "startServerReadyTimeout": 180000,
      "url": [
        "https://localhost:3443/",
        "https://localhost:3443/barba",
        "https://localhost:3443/produtos/oleo-para-barba"
      ],
      "numberOfRuns": 2,
      "settings": {
        "budgetPath": "./budgets.json",
        "chromeFlags": "--ignore-certificate-errors"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 256000 }],
        "resource-summary:third-party:size": ["error", { "maxNumericValue": 153600 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "entrega/*": false
    }
  },
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA; [ -n \"$P\" ] && [ \"$P\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet \"$P\" HEAD -- . ':!ferramentas' ':!*.md' ':!budgets.json' ':!lighthouserc.json' ../../package.json ../../package-lock.json ../../turbo.json"
}

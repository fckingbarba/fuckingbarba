# ─────────────────────────────────────────────────────────────────────────────
# Loja (Next.js) · FuckingBarba
# Copie para .env.local (local) ou cole na Vercel (Environment Variables).
# NEXT_PUBLIC_* vai pro navegador — nunca coloque segredo com esse prefixo.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública da loja. Local: http://localhost:3000 · Produção: https://www.SEUDOMINIO.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Loja atual na Nuvemshop, enquanto a nova não vira (some na fase 6).
NEXT_PUBLIC_LOJA_ATUAL_URL=https://www.SUALOJA.com.br

# ── Medusa ──────────────────────────────────────────────────────────────────
# Servidor: local http://localhost:9000 · Railway https://api.SEUDOMINIO.com.br
MEDUSA_BACKEND_URL=http://localhost:9000
# Chave publicável: aparece no log do `npm run backend:migrate` ou em
# Admin → Settings → Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Segredo que o Medusa manda em POST /api/revalidar (fase 3). openssl rand -hex 32
REVALIDAR_SEGREDO=

# ── Supabase (só pra liberar o domínio das imagens no next/image) ───────────
NEXT_PUBLIC_SUPABASE_REF=

# ── Analytics (seção "Tags" da arquitetura) ─────────────────────────────────
# Sem valor, nenhuma tag carrega. Com valor, GA4 sobe com Consent Mode v2 negado
# até o visitante aceitar.
NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=      fase 3

# Só em produção de verdade a loja indexa. Na Vercel isso vem de VERCEL_ENV;
# fora dela (Railway, local) force com SITE_INDEXAVEL=true.
# SITE_INDEXAVEL=false

# ─────────────────────────────────────────────────────────────────────────────
# Medusa · FuckingBarba
# Copie para .env (local) ou cole no Railway (server e worker).
# Tudo que está marcado [server] e [worker] vai NOS DOIS serviços do Railway,
# exceto WORKER_MODE e ADMIN_DISABLED, que diferem.
# ─────────────────────────────────────────────────────────────────────────────

# ── Processo ────────────────────────────────────────────────────────────────
# local: deixe vazio (roda tudo junto). Railway: "server" num serviço, "worker" no outro.
WORKER_MODE=
# true no worker (não compila nem serve o admin); false no server.
ADMIN_DISABLED=false
# URL pública da API — o admin usa pra falar com o backend. [server]
# Local: http://localhost:9000 · Railway: https://api.SEUDOMINIO.com.br
MEDUSA_BACKEND_URL=http://localhost:9000
PORT=9000

# ── Banco (Supabase) ────────────────────────────────────────────────────────
# Local (docker compose up): postgres://fuckingbarba:fuckingbarba@localhost:5432/fuckingbarba
#
# Supabase → Project Settings → Database → Connection string → "Session pooler"
#   postgresql://postgres.SEUREF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Regras:
#   1. Porta 5432 (sessão). A 6543 (transação) NÃO funciona com o Medusa.
#   2. Acrescente ?ssl_mode=disable no fim (exigência do Medusa quando
#      DATABASE_SSL=true; a conexão continua criptografada).
#   3. DATABASE_SSL=true no Railway, false localmente.
DATABASE_URL=postgres://fuckingbarba:fuckingbarba@localhost:5432/fuckingbarba
DATABASE_SSL=false

# ── Redis (Railway plugin) ──────────────────────────────────────────────────
# Um Redis só serve cache, eventos, workflows, locks e sessão.
# Railway: use a variável de referência ${{Redis.REDIS_URL}} nos dois serviços.
REDIS_URL=redis://localhost:6379

# ── CORS ────────────────────────────────────────────────────────────────────
# Loja (Next.js): local + preview da Vercel + domínio final.
STORE_CORS=http://localhost:3000,https://*.vercel.app,https://www.SEUDOMINIO.com.br,https://SEUDOMINIO.com.br
# Admin e auth: onde o admin é servido (mesma origem da API) + dev do admin.
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://api.SEUDOMINIO.com.br
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173,https://api.SEUDOMINIO.com.br,https://www.SEUDOMINIO.com.br

# ── Segredos ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48   (um valor por variável, diferente por ambiente)
JWT_SECRET=troque-em-producao
COOKIE_SECRET=troque-em-producao

# ── Imagens (Supabase Storage via S3) ───────────────────────────────────────
# Sem S3_BUCKET o Medusa grava em disco local (só serve pra desenvolvimento).
# Supabase → Storage → crie o bucket "produtos" (público) → Settings → S3 → New access key
# S3_FILE_URL=https://SEUREF.supabase.co/storage/v1/object/public/produtos
# S3_ENDPOINT=https://SEUREF.storage.supabase.co/storage/v1/s3
# S3_REGION=sa-east-1              (a região do projeto, como aparece em Settings → S3)
# S3_BUCKET=produtos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# ── Frete cotado na hora, pela Frenet ───────────────────────────────────────
# [server] O token da sua conta na Frenet. Sem ele o servidor SOBE do mesmo
# jeito e avisa no log, mas toda cotação falha e cai no "frete de emergência"
# das Configurações da loja — e se ele estiver vazio, ninguém consegue fechar
# pedido, porque o Medusa não completa carrinho sem método de envio.
#
# NUNCA em código, nunca no git: esta variável vive no Railway.
FRENET_TOKEN=
#
# Segundos que a loja espera a cotação antes de desistir, em milissegundos.
# Isto roda com o cliente parado na tela de entrega — passou disso, vale mais
# cair na emergência do que continuar esperando.
# FRENET_TEMPO_LIMITE_MS=6000
#
# Só pra teste: aponta a cotação pra outro endereço. O `conferir-frete.mjs`
# sobe uma Frenet falsa e usa isto pra poder testar a QUEDA dela, que é o
# caminho que mais importa e o único que a API de verdade não sabe encenar.
# Em produção esta variável não existe.
# FRENET_URL=http://127.0.0.1:4310/shipping/quote

# ── Pagamento pelo Pagar.me (Pix e cartão) ──────────────────────────────────
# [server] e [worker] — os DOIS. O server cobra (fecha o pedido); o worker
# concilia (Pix vencido, aviso que não chegou, cobrança que sumiu no caminho).
#
# A chave SECRETA da conta: Pagar.me → Configurações → Chaves. Comece pela de
# teste (sk_test_…) e só troque pela de produção depois do conferidor passar.
# NUNCA em código, nunca no git, nunca colada em conversa: esta variável vive
# no Railway. A chave PÚBLICA (pk_…) não mora aqui: vai na Vercel, como
# NEXT_PUBLIC_PAGARME_PUBLIC_KEY, porque quem tokeniza o cartão é o navegador.
PAGARME_SECRET_KEY=
#
# O cabeçalho que a Edge Function `webhook-pagamento` manda ao repassar um
# aviso do Pagar.me. Tem que ser IGUAL ao MEDUSA_WEBHOOK_SEGREDO dos secrets
# do Supabase. Sem ele todo aviso é ignorado, e Pix pago só vira pedido pago
# na conciliação, a cada 5 minutos. Gere com: openssl rand -hex 32
MEDUSA_WEBHOOK_SEGREDO=
#
# Quantos minutos o QR do Pix vale (padrão 30). Depois disso e de 10 minutos
# de folga, a conciliação cancela o pedido e devolve o estoque.
# PAGARME_PIX_MINUTOS=30
#
# Só pra teste: aponta a API pra outro endereço. O `conferir-pagamento.mjs`
# sobe um Pagar.me falso e usa isto. Em produção esta variável não existe.
# PAGARME_URL=http://127.0.0.1:4320/core/v5

# ── Fases seguintes (deixe vazio por enquanto) ──────────────────────────────
# MELHOR_ENVIO_TOKEN=            reserva, se a Frenet não servir
# BLING_CLIENT_ID= / BLING_CLIENT_SECRET=   fase 5
# RESEND_API_KEY=                fase 5

# ── Avisar a loja quando uma configuração mudar ─────────────────────────────
# [server] Quando alguém salva a tela de Configurações do admin, o Medusa
# chama POST <LOJA_URL>/api/revalidar pra derrubar o cache da vitrine. Sem
# estas duas, a gravação FUNCIONA mas a loja segue mostrando o valor velho
# até a etiqueta vencer sozinha — e nesse meio-tempo ela anuncia um piso de
# frete que o carrinho já não pratica.
#
# O segredo tem que ser IGUAL ao REVALIDAR_SEGREDO da Vercel.
LOJA_URL=https://www.fuckingbarba.com.br
REVALIDAR_SEGREDO=

# ─────────────────────────────────────────────────────────────────────────────
# Medusa · FuckingBarba
# Copie para .env (local) ou cole no Railway (server e worker).
# Tudo que está marcado [server] e [worker] vai NOS DOIS serviços do Railway,
# exceto WORKER_MODE e ADMIN_DISABLED, que diferem.
# ─────────────────────────────────────────────────────────────────────────────

# ── Processo ────────────────────────────────────────────────────────────────
# local: deixe vazio (roda tudo junto). Railway: "server" num serviço, "worker" no outro.
WORKER_MODE=
# true no worker (não compila nem serve o admin); false no server.
ADMIN_DISABLED=false
# URL pública da API — o admin usa pra falar com o backend, e é dela que sai o
# endereço do aviso de rastreio que vai em cada pedido pro painel da Frenet
# (ver FRENET_PARCEIRO_TOKEN). [server] e [worker]
# Local: http://localhost:9000 · Railway: https://api.SEUDOMINIO.com.br
MEDUSA_BACKEND_URL=http://localhost:9000
PORT=9000

# ── Banco (Supabase) ────────────────────────────────────────────────────────
# Local (docker compose up): postgres://fuckingbarba:fuckingbarba@localhost:5432/fuckingbarba
#
# Supabase → Project Settings → Database → Connection string → "Session pooler"
#   postgresql://postgres.SEUREF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Regras:
#   1. Porta 5432 (sessão). A 6543 (transação) NÃO funciona com o Medusa.
#   2. Acrescente ?ssl_mode=disable no fim (exigência do Medusa quando
#      DATABASE_SSL=true; a conexão continua criptografada).
#   3. DATABASE_SSL=true no Railway, false localmente.
DATABASE_URL=postgres://fuckingbarba:fuckingbarba@localhost:5432/fuckingbarba
DATABASE_SSL=false

# ── Redis (Railway plugin) ──────────────────────────────────────────────────
# Um Redis só serve cache, eventos, workflows, locks e sessão.
# Railway: use a variável de referência ${{Redis.REDIS_URL}} nos dois serviços.
REDIS_URL=redis://localhost:6379

# ── CORS ────────────────────────────────────────────────────────────────────
# Loja (Next.js): local + preview da Vercel + domínio final.
STORE_CORS=http://localhost:3000,https://*.vercel.app,https://www.SEUDOMINIO.com.br,https://SEUDOMINIO.com.br
# Admin e auth: onde o admin é servido (mesma origem da API) + dev do admin.
ADMIN_CORS=http://localhost:9000,http://localhost:5173,https://api.SEUDOMINIO.com.br
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173,https://api.SEUDOMINIO.com.br,https://www.SEUDOMINIO.com.br

# ── Segredos ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 48   (um valor por variável, diferente por ambiente)
JWT_SECRET=troque-em-producao
COOKIE_SECRET=troque-em-producao

# ── Imagens (Supabase Storage via S3) ───────────────────────────────────────
# Sem S3_BUCKET o Medusa grava em disco local (só serve pra desenvolvimento).
# Supabase → Storage → crie o bucket "produtos" (público) → Settings → S3 → New access key
# S3_FILE_URL=https://SEUREF.supabase.co/storage/v1/object/public/produtos
# S3_ENDPOINT=https://SEUREF.storage.supabase.co/storage/v1/s3
# S3_REGION=sa-east-1              (a região do projeto, como aparece em Settings → S3)
# S3_BUCKET=produtos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=

# ── Frete cotado na hora, pela Frenet ───────────────────────────────────────
# [server] O token da sua conta na Frenet. Sem ele o servidor SOBE do mesmo
# jeito e avisa no log, mas toda cotação falha e cai no "frete de emergência"
# das Configurações da loja — e se ele estiver vazio, ninguém consegue fechar
# pedido, porque o Medusa não completa carrinho sem método de envio.
#
# NUNCA em código, nunca no git: esta variável vive no Railway.
FRENET_TOKEN=
#
# Segundos que a loja espera a cotação antes de desistir, em milissegundos.
# Isto roda com o cliente parado na tela de entrega — passou disso, vale mais
# cair na emergência do que continuar esperando.
# FRENET_TEMPO_LIMITE_MS=6000
#
# Só pra teste: aponta a cotação pra outro endereço. O `conferir-frete.mjs`
# sobe uma Frenet falsa e usa isto pra poder testar a QUEDA dela, que é o
# caminho que mais importa e o único que a API de verdade não sabe encenar.
# Em produção esta variável não existe.
# FRENET_URL=http://127.0.0.1:4310/shipping/quote
#
# [server] A chave dos avisos de rastreio que a Frenet manda pra
# https://<api>/hooks/envio/frenet (o webhook "Atualização de Tracking").
# Você cria o valor (openssl rand -hex 32), põe aqui no Railway e passa pra
# Frenet cadastrar como o cabeçalho `x-webhook-token` (o TOKEN_NAME/TOKEN_VALUE
# da documentação deles) — ou, se ela só aceitar a URL, no fim dela:
# …/hooks/envio/frenet?chave=<o valor>. Sem esta variável, NENHUM aviso entra
# (a porta falha fechada) e o log diz por quê; o rastreio segue valendo pelo
# "Mark as shipped" do admin. NUNCA em código, nunca colada em conversa.
# Localmente e no conferidor de envio: token-de-teste.
FRENET_WEBHOOK_TOKEN=
#
# [server] e [worker] O token de PARCEIRO da Frenet (x-partner-token): com ele,
# o pedido pago entra SOZINHO no painel da Frenet (a API de pedidos deles),
# como na Nuvemshop — quem despacha só gera a etiqueta, e o aviso de rastreio
# volta com o pedido "enviado". A Frenet só entrega depois da homologação; sem
# ele, nada vai pro painel e a etiqueta continua à mão. Vale pros pedidos pagos
# DEPOIS de ligar (ESTADO, 1b). Cada pedido leva o endereço do aviso dele,
# montado com o MEDUSA_BACKEND_URL e assinado com o FRENET_WEBHOOK_TOKEN.
# NUNCA em código, nunca colado em conversa. No conferidor: parceiro-de-teste.
FRENET_PARCEIRO_TOKEN=
#
# Só pra teste: aponta a API de pedidos pra Frenet falsa do conferir-envio.mjs.
# Em produção esta variável não existe.
# FRENET_WHITELABEL_URL=http://127.0.0.1:4310

# ── Pagamento pelo Pagar.me (Pix e cartão) ──────────────────────────────────
# [server] e [worker] — os DOIS. O server cobra (fecha o pedido); o worker
# concilia (Pix vencido, aviso que não chegou, cobrança que sumiu no caminho).
#
# A chave SECRETA da conta: Pagar.me → Configurações → Chaves. Comece pela de
# teste (sk_test_…) e só troque pela de produção depois do conferidor passar.
# NUNCA em código, nunca no git, nunca colada em conversa: esta variável vive
# no Railway. A chave PÚBLICA (pk_…) não mora aqui: vai na Vercel, como
# NEXT_PUBLIC_PAGARME_PUBLIC_KEY, porque quem tokeniza o cartão é o navegador.
PAGARME_SECRET_KEY=
#
# O cabeçalho que a Edge Function `webhook-pagamento` manda ao repassar um
# aviso do Pagar.me. Tem que ser IGUAL ao MEDUSA_WEBHOOK_SEGREDO dos secrets
# do Supabase. Sem ele todo aviso é ignorado, e Pix pago só vira pedido pago
# na conciliação, a cada 5 minutos. Gere com: openssl rand -hex 32
MEDUSA_WEBHOOK_SEGREDO=
#
# Quantos minutos o QR do Pix vale (padrão 30). Depois disso e de 10 minutos
# de folga, a conciliação cancela o pedido e devolve o estoque.
# PAGARME_PIX_MINUTOS=30
#
# Só pra teste: aponta a API pra outro endereço. O `conferir-pagamento.mjs`
# sobe um Pagar.me falso e usa isto. Em produção esta variável não existe.
# PAGARME_URL=http://127.0.0.1:4320/core/v5

# ── E-mail, pelo Resend ─────────────────────────────────────────────────────
# [server] É por ele que sai o código de acesso da Minha conta — sem ele,
# ninguém entra na conta. Resend → API Keys → Create API Key, com permissão
# "Sending access" e o domínio da loja. NUNCA em código, nunca colada em
# conversa: esta variável vive no Railway.
#
# Sem a chave o servidor sobe do mesmo jeito. Fora de produção o e-mail vai
# pro LOG (com o código) — é assim que se entra na conta no desenvolvimento.
# Em produção nada sai, e a loja diz "não conseguimos mandar o código agora".
RESEND_API_KEY=
#
# Quem aparece como remetente. O domínio tem que estar VERIFICADO no Resend
# (Domains → os registros no DNS), senão o Resend recusa e o log diz por quê.
# EMAIL_REMETENTE=FuckingBarba <nao-responda@fuckingbarba.com.br>
#
# Só pra teste: aponta o envio pra outro endereço. O `conferir-conta.mjs`
# sobe um Resend falso e lê o código de lá. Em produção esta variável não existe.
# RESEND_URL=http://127.0.0.1:4330

# ── O ERP: o Bling ──────────────────────────────────────────────────────────
# [server] e [worker] O app PRIVADO da loja no Bling (Central de Extensões →
# Área do Integrador → Criar aplicativo). Com os dois, a tela ERP do admin
# mostra "Conectar o Bling"; conectado, o estoque da loja passa a espelhar o
# do Bling (de 5 em 5 minutos e pelo aviso dele) e todo pedido pago vira
# pedido de venda + NF-e lá, direto pra SEFAZ. Sem eles, nada disso existe e
# a loja segue como antes. O secret também é a chave que cifra os tokens no
# banco: trocou o secret no Bling, conecte de novo no admin. NUNCA em código,
# nunca colados em conversa. O passo a passo (URL de volta, escopos, webhook)
# está no ESTADO, e o porquê em apps/backend/src/modules/bling/autorizacao.ts.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
#
# Só pra teste: apontam a API e a tela de autorização pro Bling falso do
# conferir-erp.mjs. Em produção estas variáveis não existem.
# BLING_URL=http://127.0.0.1:4340/Api/v3
# BLING_AUTORIZACAO_URL=http://127.0.0.1:4340/Api/v3/oauth/authorize
#
# A loja antiga, de onde a tela "Endereços e fotos da Nuvemshop" lê (sem
# senha: o mapa do site e as páginas públicas). O padrão é a de verdade,
# https://www.fuckingbarba.com.br; só o conferir-erp aponta pra falsa.
# NUVEMSHOP_LOJA_URL=http://127.0.0.1:4350

# ── Fases seguintes (deixe vazio por enquanto) ──────────────────────────────
# MELHOR_ENVIO_TOKEN=            reserva, se a Frenet não servir

# ── Avisar a loja quando uma configuração mudar ─────────────────────────────
# [server] Quando alguém salva a tela de Configurações do admin, o Medusa
# chama POST <LOJA_URL>/api/revalidar pra derrubar o cache da vitrine. Sem
# estas duas, a gravação FUNCIONA mas a loja segue mostrando o valor velho
# até a etiqueta vencer sozinha — e nesse meio-tempo ela anuncia um piso de
# frete que o carrinho já não pratica.
#
# O segredo tem que ser IGUAL ao REVALIDAR_SEGREDO da Vercel. Ele também
# assina o IP de quem pede código de acesso (a loja manda junto): sem ele, o
# limite de códigos por pessoa não enxerga a pessoa, só a Vercel — e o log
# avisa ("pedido de código sem a assinatura da loja").
LOJA_URL=https://www.fuckingbarba.com.br
REVALIDAR_SEGREDO=

# ── O painel da loja (dashboard.fuckingbarba.com.br) ────────────────────────
# [server] O painel é um app próprio na Vercel (apps/dashboard) que chama as
# rotas /dashboard/* deste backend, assinando com o REVALIDAR_SEGREDO lá de
# cima — o mesmo valor nos três lugares (Railway, loja e painel na Vercel).
#
# DASHBOARD_DONO_EMAIL é quem entra primeiro, como dono: o painel não tem
# cadastro, e a equipe nasce vazia. Só vale enquanto não houver nenhum dono
# ativo — depois, quem convida e remove é o próprio painel.
#
# DASHBOARD_URL é o endereço do painel, pro botão do e-mail de convite. Sem
# ele o convite sai sem botão.
DASHBOARD_DONO_EMAIL=
DASHBOARD_URL=https://dashboard.fuckingbarba.com.br
#
# As VISITAS DO DIA no Início do painel vêm do Google Analytics (GA4), pela
# API de dados do Google, com uma CONTA DE SERVIÇO que só lê: ela é Leitor
# na propriedade do GA4 da loja, e nada mais. Sem as duas, o Início mostra
# "o Google Analytics ainda não está ligado" no lugar do número.
#
# GA4_PROPERTY_ID é o NÚMERO da propriedade (Administrador → Detalhes da
# propriedade; só dígitos — o "G-XXXX" da tag é outra coisa).
# GA4_CREDENCIAIS é a chave da conta de serviço: o arquivo .json que o
# Google baixa, colado INTEIRO no valor da variável (ou o mesmo em base64).
# É uma senha: NUNCA em código, nunca colada em conversa. O passo a passo
# está no ESTADO (4.5).
GA4_PROPERTY_ID=
GA4_CREDENCIAIS=
#
# Só pra teste: GA4_API_URL aponta a API pro Google falso do
# conferir-visitas.mjs (o endereço do token vem da própria chave, o
# token_uri) e GA4_CACHE_SEGUNDOS=0 desliga a memória das respostas (120
# segundos, sem ela). Em produção estas variáveis não existem.
# GA4_API_URL=http://127.0.0.1:4360/v1beta
# GA4_CACHE_SEGUNDOS=0

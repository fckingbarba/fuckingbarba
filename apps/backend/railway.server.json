{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @fuckingbarba/backend",
    "watchPatterns": ["apps/backend/**", "package.json", "package-lock.json", "turbo.json"]
  },
  "deploy": {
    "preDeployCommand": ["cd apps/backend/.medusa/server && npx medusa db:migrate"],
    "startCommand": "cd apps/backend/.medusa/server && npm run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
